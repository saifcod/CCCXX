rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Comprehensive Admin Authorization:
    // Matches by designated UID, admin email whitelist, or registered document in /admins
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'rNnmHoQ3c5cUB1ljnPms4o2GxUv2' ||
        (
          'email' in request.auth.token &&
          (
            request.auth.token.email.lower() in [
              'mdrecover470@gmail.com',
              'unexpectedsaiff@gmil.com',
              'unexpectedsaiff@gmail.com',
              'admin@corelux.com'
            ] ||
            request.auth.token.email in [
              'mdrecover470@gmail.com',
              'unexpectedsaiff@gmil.com',
              'unexpectedsaiff@gmail.com',
              'admin@corelux.com'
            ]
          )
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // Customer and Guest Orders
    match /orders/{orderId} {
      allow create: if true;
      allow get: if (
        isAdmin() ||
        (isSignedIn() && 'customerId' in resource.data && resource.data.customerId == request.auth.uid)
      );
      allow list: if (
        isAdmin() ||
        (isSignedIn() && 'customerId' in resource.data && resource.data.customerId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // Product catalog: readable by public/storefront, fully writable by admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin authorization entries
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
    }

    // Store Settings & Banners
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
